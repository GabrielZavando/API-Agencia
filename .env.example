# ===============================================
# CONFIGURACIÓN DE FIREBASE
# ===============================================
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=""
FIREBASE_CLIENT_EMAIL=

# ===============================================
# CONFIGURACIÓN DE ENVÍO DE EMAILS (RESEND)
# Dominio verificado: notify.gabrielzavando.cl
# ===============================================
RESEND_API_KEY=

# Remitentes por canal (deben ser subdominios verificados en Resend)
# Correos al usuario final (diagnóstico, newsletter, respuesta contacto, etc.)
MAIL_FROM_NOTIFY="Gabriel Zavando <no-reply@notify.gabrielzavando.cl>"

# Alertas internas al administrador
MAIL_FROM_ADMIN="Notificaciones <notificaciones@notify.gabrielzavando.cl>"

# Correos de soporte (tickets, informes)
MAIL_FROM_SUPPORT="Soporte Gabriel Zavando <soporte@notify.gabrielzavando.cl>"

# Reply-To por canal (a dónde responde el usuario si hace clic en 'Responder')
MAIL_REPLY_TO_NOTIFY=contacto@gabrielzavando.cl
MAIL_REPLY_TO_ADMIN=contacto@gabrielzavando.cl
MAIL_REPLY_TO_SUPPORT=soporte@gabrielzavando.cl

# Destinatario de notificaciones administrativas
MAIL_ADMIN_ADDRESS=contacto@gabrielzavando.cl


# ===============================================
# CONFIGURACIÓN DE SEGURIDAD
# ===============================================

ALLOWED_ORIGINS=

# ===============================================
# CONFIGURACIÓN DE INTELIGENCIA ARTIFICIAL
